<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    android:layout_marginHorizontal="@dimen/_12sdp"
    android:backgroundTint="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Illustration -->
        <ImageView
            android:id="@+id/imgIllustration"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_brain_bulb"
            android:contentDescription="AI Assistant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/what_do_you_want_to_create"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/imgIllustration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Option 1 – CV -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardCv"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:background="@drawable/bg_option_cv"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardCoverLetter">

            <ImageView
                android:id="@+id/imgCvIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/cv_place_holder"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/tvCvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/create_cv_resume"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgCvIcon"
                app:layout_constraintEnd_toEndOf="parent"
               />

            <TextView
                android:id="@+id/tvCvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/edit_and_create_your_cv"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCvTitle"
                app:layout_constraintEnd_toEndOf="parent"
               />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Option 2 – Cover Letter -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardCoverLetter"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:background="@drawable/bg_option_cover"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toEndOf="@id/cardCv"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgCoverIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_cover_letter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                 />

            <TextView
                android:id="@+id/tvCoverTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/write_cover_letter"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@+id/imgCoverIcon"
               app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvCoverSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/craft_standout_cover_letter"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCoverTitle"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
