<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_top_corners"
    >

    <ImageView
        android:id="@+id/bottomSheetGrapple"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:src="@drawable/ic_bottom_sheet_grapple"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_28sdp"
        android:fontFamily="@font/poppins_regular"
        android:paddingHorizontal="@dimen/_5sdp"
        android:text="@string/mayer_sabilla"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="@dimen/_17sdp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/edit_txt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginVertical="@dimen/_10sdp"
        android:drawableStart="@drawable/edit_profile_icon"
        android:drawablePadding="@dimen/_15sdp"
        android:background="@drawable/ic_bg_pro"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:text="@string/edit"
        android:paddingHorizontal="@dimen/_10sdp"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rename_txt"
        app:layout_constraintTop_toBottomOf="@id/text" />




    <TextView
        android:id="@+id/rename_txt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginVertical="@dimen/_10sdp"
        android:background="@drawable/ic_bg_pro"
        android:drawableStart="@drawable/rename_profile_icon"
        android:drawablePadding="@dimen/_15sdp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:text="@string/rename"
        android:paddingHorizontal="@dimen/_10sdp"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/share_txt"
        app:layout_constraintTop_toBottomOf="@id/edit_txt" />







    <TextView
        android:id="@+id/share_txt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginVertical="@dimen/_10sdp"
        android:background="@drawable/ic_bg_pro"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:drawableStart="@drawable/share_profile_icon"
        android:drawablePadding="@dimen/_15sdp"
        android:text="Share"
        android:visibility="gone"
        android:paddingHorizontal="@dimen/_10sdp"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/delete_txt"
        app:layout_constraintTop_toBottomOf="@id/rename_txt" />




    <TextView
        android:id="@+id/delete_txt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginVertical="@dimen/_10sdp"
        android:background="@drawable/ic_bg_pro"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:drawableStart="@drawable/delete_profile_icon"
        android:drawablePadding="@dimen/_15sdp"
        android:text="@string/delete"
        android:paddingHorizontal="@dimen/_10sdp"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/share_txt" />

\

</androidx.constraintlayout.widget.ConstraintLayout>
